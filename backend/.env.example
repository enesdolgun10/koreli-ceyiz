# ==========================================
# BACKEND ÇEVRE DEĞİŞKENLERİ (ENV CONFIG)
# ==========================================

# Supabase veya PostgreSQL Veritabanı Bağlantı URL'i (Direct Connection Port: 5432)
# Örnek: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Yönetici Paneli Giriş Şifresi
ADMIN_PASSWORD=guclu_bir_yonetici_sifresi

# JWT Token İmzalamak İçin Gizli Anahtar (32+ karakter rastgele string)
JWT_SECRET=super_secret_jwt_key_degistirmeyi_unutmayin

# İzin Verilen CORS Adresleri (Virgülle ayırarak birden fazla alan adı girebilirsiniz veya * yapabilirsiniz)
# Örnek: http://localhost:3000,https://koreliceyiz.com
ALLOWED_ORIGINS=*
