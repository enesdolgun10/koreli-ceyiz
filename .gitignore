# ==========================================
# KORELİ ÇEYİZ - Git Ignore Configuration
# ==========================================

# --- Node & Next.js (Frontend) ---
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
frontend/build/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Python & FastAPI (Backend) ---
backend/venv/
venv/
env/
ENV/
backend/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/keep_alive_log.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & Secret Variables ---
# (Asla gerçek şifre ve anahtarları repoya eklemeyin)
.env
.env*.local
backend/.env
frontend/.env
frontend/.env.local
*.pem
*.key

# Örnek env dosyalarını koru
!.env.example
!backend/.env.example
!frontend/.env.example

# --- IDEs, Agents & System Files ---
.agents/
AGENTS.md
CLAUDE.md
frontend/AGENTS.md
frontend/CLAUDE.md
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

